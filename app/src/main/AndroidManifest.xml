<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Core network & media permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- In-app update: hands the downloaded Aurex APK to Android's installer -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Required for BrowserMediaService foreground type -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- WakeLock + WifiLock for HyperOS / MIUI background media (Fix 5) -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Device / sensor permissions -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Phone lock (biometric / PIN) for the adult-filter switch -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Crisp haptic primitives (tick / click / thud) on phones with a haptic motor -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Hardware is optional so the app installs on every phone/tablet. -->
    <uses-feature android:name="android.hardware.touchscreen"       android:required="false" />
    <uses-feature android:name="android.hardware.camera"            android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus"  android:required="false" />
    <uses-feature android:name="android.hardware.microphone"        android:required="false" />
    <uses-feature android:name="android.hardware.location"          android:required="false" />
    <uses-feature android:name="android.hardware.location.gps"      android:required="false" />

    <application
        android:name=".AurexApp"
        android:label="Aurex Browser"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:largeHeap="true"
        android:extractNativeLibs="true"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.Aurex">

        <!--
            configChanges covers every dimension / orientation / UI-mode shift that
            PiP triggers so the Activity is NOT recreated on PiP enter/exit.
            launchMode="singleTask" ensures deep-links open in the existing instance.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:supportsPictureInPicture="true"
            android:resizeableActivity="true"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
            </intent-filter>
        </activity>

        <activity
            android:name=".PlayerActivity"
            android:exported="false"
            android:screenOrientation="behind"
            android:supportsPictureInPicture="true"
            android:resizeableActivity="true"
            android:theme="@style/Theme.Aurex.Player"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode" />

        <!-- Fix 5: Foreground media service for background playback (WakeLock + WifiLock). -->
        <service
            android:name=".BrowserMediaService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <service
            android:name=".DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
