<?xml version="1.0" encoding="utf-8"?>
<!-- Press feedback for the player buttons: a soft round ripple (the notification cannot animate anything else). -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#40808080">
    <item android:id="@android:id/mask">
        <shape android:shape="oval">
            <solid android:color="#FFFFFFFF" />
        </shape>
    </item>
</ripple>
