<?xml version="1.0" encoding="utf-8"?>
<!-- Collapsed player: thumbnail, title / site, thin accent progress, prev - play/pause - next. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/thumb"
        android:layout_width="64dp"
        android:layout_height="36dp"
        android:layout_marginEnd="10dp"
        android:scaleType="fitXY" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:singleLine="true"
            android:textAppearance="@android:style/TextAppearance.Material.Notification.Title"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:singleLine="true"
            android:textAppearance="@android:style/TextAppearance.Material.Notification.Line2"
            android:textSize="13sp" />

        <ImageView
            android:id="@+id/bar"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="6dp"
            android:scaleType="fitXY" />
    </LinearLayout>

    <ImageView
        android:id="@+id/btn_prev"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="4dp"
        android:background="@drawable/notif_ripple"
        android:padding="7dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_media_prev" />

    <FrameLayout
        android:id="@+id/btn_play"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginStart="2dp"
        android:layout_marginEnd="2dp"
        android:foreground="@drawable/notif_ripple">

        <ImageView
            android:id="@+id/btn_play_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:src="@drawable/notif_circle" />

        <ImageView
            android:id="@+id/btn_play_icon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="9dp"
            android:scaleType="fitCenter" />
    </FrameLayout>

    <ImageView
        android:id="@+id/btn_next"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/notif_ripple"
        android:padding="7dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_pip_next" />
</LinearLayout>
