<?xml version="1.0" encoding="utf-8"?>
<!-- Expanded player: big thumbnail, title / site, accent progress with elapsed / remaining, centred transport row. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/thumb"
            android:layout_width="128dp"
            android:layout_height="72dp"
            android:layout_marginEnd="12dp"
            android:scaleType="fitXY" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="2"
                android:textAppearance="@android:style/TextAppearance.Material.Notification.Title"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:singleLine="true"
                android:textAppearance="@android:style/TextAppearance.Material.Notification.Line2"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:id="@+id/bar"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="12dp"
        android:scaleType="fitXY" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/t_left"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFeatureSettings="tnum"
            android:gravity="start"
            android:maxLines="1"
            android:textAppearance="@android:style/TextAppearance.Material.Notification.Line2"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/t_right"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFeatureSettings="tnum"
            android:gravity="end"
            android:maxLines="1"
            android:textAppearance="@android:style/TextAppearance.Material.Notification.Line2"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/btn_prev"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/notif_ripple"
            android:padding="11dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_media_prev" />

        <FrameLayout
            android:id="@+id/btn_play"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="22dp"
            android:layout_marginEnd="22dp"
            android:foreground="@drawable/notif_ripple">

            <ImageView
                android:id="@+id/btn_play_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:src="@drawable/notif_circle" />

            <ImageView
                android:id="@+id/btn_play_icon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="12dp"
                android:scaleType="fitCenter" />
        </FrameLayout>

        <ImageView
            android:id="@+id/btn_next"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/notif_ripple"
            android:padding="11dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_pip_next" />
    </LinearLayout>
</LinearLayout>
